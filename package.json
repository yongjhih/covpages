{
  "name": "covpages",
  "version": "0.1.0",
  "description": "Impeccable GitHub-styled coverage report generator for GitHub Pages with multi-commit trends by repo, folder, and file",
  "type": "module",
  "bin": {
    "covpages": "./bin/covpages.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:website": "node bin/build-website.js docs",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:impeccable": "~/.impeccable/bin/0.1.6/impeccable detect"
  },
  "keywords": [
    "coverage",
    "lcov",
    "github-pages",
    "gh-pages",
    "cobertura",
    "istanbul",
    "trend",
    "reporting",
    "github-style",
    "codecov",
    "coveralls"
  ],
  "author": "covpages contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/prismjs": "^1.26.6",
    "@vitest/coverage-v8": "^2.1.2",
    "prismjs": "^1.30.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
